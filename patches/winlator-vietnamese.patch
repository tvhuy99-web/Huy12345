+    <string name="dxwrapper_help_content"><![CDATA[
+        <i><b>WineD3D</b></i> là lớp chuyển đổi DirectX 1–11 sang OpenGL.<br /><br />
+        <i><b>DXVK</b></i> là lớp chuyển đổi Direct3D 9–11 sang Vulkan.<br /><br />
+        <i><b>VKD3D</b></i> là lớp chuyển đổi API Direct3D 12 sang Vulkan.<br /><br />
+        <i><b>CNC DDraw</b></i> là phiên bản DirectDraw giúp tăng khả năng tương thích với các trò chơi cổ điển.
+    ]]></string>
+    <string name="box64_env_var_help__dynarec_safeflags"><![CDATA[
+        Cách xử lý cờ của các lệnh CALL/RET<br /><br />
+        <b>0</b>: Xem như CALL/RET không cần cờ (nhanh hơn, kém ổn định)<br />
+        <b>1</b>: Hầu hết RET cần cờ, phần lớn CALL thì không<br />
+        <b>2</b>: Mọi CALL/RET đều cần cờ (chậm hơn)
+    ]]></string>
+    <string name="box64_env_var_help__dynarec_fastnan">Tạo giá trị -NAN như trên x86</string>
+    <string name="box64_env_var_help__dynarec_fastround"><![CDATA[
+        Mô phỏng phép làm tròn chính xác của x86<br /><br />
+        <b>0</b>: Làm tròn float/double sang int như trên x86<br />
+        <b>1</b>: Không xử lý riêng các trường hợp biên để tăng tốc (không chuyển INF/NAN/tràn số thành MIN_INT)<br />
+        <b>2</b>: Bao gồm chế độ 1 và làm tròn nhanh double sang float (không xét chế độ làm tròn hiện tại)
+    ]]></string>
+    <string name="box64_env_var_help__dynarec_x87double">Dùng Float/Double để mô phỏng x87</string>
+    <string name="box64_env_var_help__dynarec_bigblock"><![CDATA[
+        Tạo khối lớn cho bộ dịch mã động<br /><br />
+        <b>0</b>: Không cố tạo khối lớn nhất có thể<br />
+        <b>1</b>: Tạo khối lớn nhất có thể<br />
+        <b>2</b>: Tiếp tục tạo khối khi có vùng chồng lấp, nhưng chỉ với bộ nhớ ELF<br />
+        <b>3</b>: Tiếp tục tạo khối khi có vùng chồng lấp với mọi loại bộ nhớ
+    ]]></string>
+    <string name="box64_env_var_help__dynarec_strongmem"><![CDATA[
+        Mô phỏng mô hình bộ nhớ mạnh<br /><br />
+        <b>0</b>: Không áp dụng xử lý đặc biệt<br />
+        <b>1</b>: Thêm một số hàng rào bộ nhớ khi ghi bằng một số lệnh MOV<br />
+        <b>2</b>: Như chế độ 1, đồng thời thêm hàng rào mỗi khi lệnh MOV ghi bộ nhớ<br />
+        <b>3</b>: Như chế độ 2, đồng thời thêm hàng rào khi đọc bộ nhớ và với một số lệnh SSE/SSE2
+    ]]></string>
+    <string name="box64_env_var_help__dynarec_weakbarrier"><![CDATA[
+        Điều chỉnh hàng rào bộ nhớ để giảm ảnh hưởng hiệu năng của strongmem<br /><br />
+        <b>0</b>: Dùng hàng rào an toàn thông thường<br />
+        <b>1</b>: Dùng hàng rào yếu để tăng hiệu năng<br />
+        <b>2</b>: Như chế độ 1, đồng thời tắt các hàng rào ghi cuối cùng
+    ]]></string>
