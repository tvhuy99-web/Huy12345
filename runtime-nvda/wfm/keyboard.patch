+/* NVDA reads this real selection through a bounded WM_GETTEXT query. */
+void publishContentSelection(void) {
+    int index = ListView_GetNextItem(hwndContentView, -1, LVNI_FOCUSED);
+    if (index < 0) index = ListView_GetNextItem(hwndContentView, -1, LVNI_SELECTED);
+    wchar_t text[1024];
+    if (items && index >= 0 && index < numItems) {
+        struct FileNode* node = items[index].node;
+        const wchar_t* kind = node->type == TYPE_FILE ? L"Tệp" : node->type == TYPE_DRIVE ? L"Ổ đĩa" : L"Thư mục";
+        StringCchPrintfW(text, 1024, L"%ls. %ls. Mục %d trên %d.", node->name, kind, index + 1, numItems);
+        text[1023] = 0;
+    } else StringCchPrintfW(text, 1024, L"Danh sách tệp. %d mục. Chưa chọn mục nào.", numItems);
+    SetDlgItemTextW(hwndMain, 0x7e01, text);
+}
+
+void focusContentSelection(void) {
+    SetFocus(hwndContentView);
+    if (numItems > 0 && ListView_GetNextItem(hwndContentView, -1, LVNI_FOCUSED) < 0) {
+        ListView_SetItemState(hwndContentView, 0, LVIS_FOCUSED | LVIS_SELECTED, LVIS_FOCUSED | LVIS_SELECTED);
+        ListView_EnsureVisible(hwndContentView, 0, FALSE);
+    }
+    publishContentSelection();
+}
