diff --git a/src/main.c b/src/main.c
index 7ca1979..8fee4e0 100644
--- a/src/main.c
+++ b/src/main.c
@@ -281,6 +281,10 @@ int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, PSTR lpCmdLine,
                               0, 0, hwndWidth, hwndHeight, NULL, NULL, hInstance, NULL);
     if (!hwndMain) return 0;
     
+    /* Versioned, read-only selection text. No files, logs or network endpoints. */
+    CreateWindowW(L"Static", L"", WS_CHILD, 0,0,0,0, hwndMain, (HMENU)0x7e01,hInstance,NULL);
+    CreateWindowW(L"Static", L"WFM-NVDA-1", WS_CHILD, 0,0,0,0, hwndMain, (HMENU)0x7e02,hInstance,NULL);
+    CreateWindowW(L"Static", L"", WS_CHILD, 0,0,0,0, hwndMain, (HMENU)0x7e03,hInstance,NULL);
     createMainMenu();
     createToolbar();
     createNavbar();
@@ -300,9 +304,32 @@ int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance, PSTR lpCmdLine,
 
     ShowWindow(hwndMain, SW_SHOW);
     UpdateWindow(hwndMain);
+    focusContentSelection();
 
     MSG msg;
     while(GetMessage(&msg, NULL, 0, 0) > 0) {
+        if (msg.message == WM_KEYDOWN && GetAncestor(msg.hwnd, GA_ROOT) == hwndMain) {
+            HWND focus = GetFocus();
+            int index = focus == hwndContentView ? 0 : focus == hwndTreeview ? 1 : accessibilityNavbarIndex(focus);
+            if (msg.wParam == VK_TAB) {
+                index = (index + ((GetKeyState(VK_SHIFT) & 0x8000) ? 3 : 1)) % 4;
+                if (index == 0) focusContentSelection();
+                else if (index == 1) {
+                    SetFocus(hwndTreeview);
+                    if (!TreeView_GetSelection(hwndTreeview)) TreeView_SelectItem(hwndTreeview, TreeView_GetRoot(hwndTreeview));
+                    publishTreeSelection();
+                } else accessibilityNavbarFocus(index);
+                continue;
+            }
+            if (msg.wParam == VK_RETURN) {
+                if (index == 0) {updateSelectedItems(); onMenuItemOpenClick(); focusContentSelection(); continue;}
+                if (index == 1) {activateTreeSelection(); continue;}
+                if (index >= 2) {accessibilityNavbarEnter(index); continue;}
+            }
+            if (focus == hwndContentView && msg.wParam == VK_BACK) {navigateUp(); focusContentSelection(); continue;}
+            if ((GetKeyState(VK_CONTROL) & 0x8000) && msg.wParam == 'L') {accessibilityNavbarFocus(2);continue;}
+            if ((GetKeyState(VK_CONTROL) & 0x8000) && msg.wParam == 'F') {accessibilityNavbarFocus(3);continue;}
+        }
         TranslateMessage(&msg);
         DispatchMessage(&msg);
     }
