diff --git a/src/accessibility.c b/src/accessibility.c
new file mode 100644
index 0000000..513c58e
--- /dev/null
+++ b/src/accessibility.c
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: MIT
+ * Execute in WFM's own GUI thread. No global keyboard injection or remote pointers.
+ */
+#include "main.h"
+extern HWND hwndMain, hwndContentView, hwndTreeview;
+
+static LRESULT moveList(UINT action) {
+    int count=ListView_GetItemCount(hwndContentView);
+    if(count<=0) {publishContentSelection();return A11Y_BOUNDARY;}
+    int old=ListView_GetNextItem(hwndContentView,-1,LVNI_FOCUSED);
+    if(old<0)old=ListView_GetNextItem(hwndContentView,-1,LVNI_SELECTED);
+    int next=old<0?0:old;
+    int page=ListView_GetCountPerPage(hwndContentView);if(page<1)page=1;
+    if(action==A11Y_HOME)next=0;
+    else if(action==A11Y_END)next=count-1;
+    else if(old>=0)next+=action==A11Y_UP?-1:action==A11Y_DOWN?1:action==A11Y_PAGEUP?-page:page;
+    if(next<0)next=0;if(next>=count)next=count-1;
+    SetFocus(hwndContentView);
+    ListView_SetItemState(hwndContentView,-1,0,LVIS_FOCUSED|LVIS_SELECTED);
+    ListView_SetItemState(hwndContentView,next,LVIS_FOCUSED|LVIS_SELECTED,LVIS_FOCUSED|LVIS_SELECTED);
+    ListView_EnsureVisible(hwndContentView,next,FALSE);
+    publishContentSelection();
+    if(ListView_GetNextItem(hwndContentView,-1,LVNI_FOCUSED)!=next)return A11Y_UNSUPPORTED;
+    return old==next?A11Y_BOUNDARY:A11Y_CHANGED;
+}
+static LRESULT moveTree(UINT action) {
+    HTREEITEM old=TreeView_GetSelection(hwndTreeview), next=old;
+    if(!next)next=TreeView_GetRoot(hwndTreeview);
+    else if(action==A11Y_UP)next=TreeView_GetPrevVisible(hwndTreeview,old);
+    else if(action==A11Y_DOWN)next=TreeView_GetNextVisible(hwndTreeview,old);
+    else if(action==A11Y_HOME)next=TreeView_GetRoot(hwndTreeview);
+    else if(action==A11Y_END)next=TreeView_GetNextItem(hwndTreeview,NULL,TVGN_LASTVISIBLE);
+    else if(action==A11Y_LEFT) {
+        if(TreeView_GetItemState(hwndTreeview,old,TVIS_EXPANDED)&TVIS_EXPANDED) {
+            TreeView_Expand(hwndTreeview,old,TVE_COLLAPSE);publishTreeSelection();return A11Y_CHANGED;
+        }
+        next=TreeView_GetParent(hwndTreeview,old);
+    } else if(action==A11Y_RIGHT) {
+        if(!(TreeView_GetItemState(hwndTreeview,old,TVIS_EXPANDED)&TVIS_EXPANDED)) {
+            if(TreeView_Expand(hwndTreeview,old,TVE_EXPAND)) {publishTreeSelection();return A11Y_CHANGED;}
+        }
+        next=TreeView_GetChild(hwndTreeview,old);
+    } else return A11Y_UNSUPPORTED;
+    if(!next)next=old;
+    if(!next)return A11Y_BOUNDARY;
+    SetFocus(hwndTreeview);TreeView_SelectItem(hwndTreeview,next);TreeView_EnsureVisible(hwndTreeview,next);
+    publishTreeSelection();
+    if(TreeView_GetSelection(hwndTreeview)!=next)return A11Y_UNSUPPORTED;
+    return old==next?A11Y_BOUNDARY:A11Y_CHANGED;
+}
+LRESULT accessibilityCommand(UINT action) {
+    if(GetForegroundWindow()!=hwndMain || !IsWindowEnabled(hwndMain))return A11Y_UNSUPPORTED;
+    GUITHREADINFO info={0};info.cbSize=sizeof(info);
+    if(!GetGUIThreadInfo(GetCurrentThreadId(),&info))return A11Y_UNSUPPORTED;
+    if(info.flags&(GUI_INMENUMODE|GUI_POPUPMENUMODE|GUI_SYSTEMMENUMODE)) {
+        if(action==A11Y_ESCAPE) {EndMenu();return A11Y_HANDLED;}
+        return A11Y_UNSUPPORTED;
+    }
+    HWND focus=GetFocus();
+    int index=focus==hwndContentView?0:focus==hwndTreeview?1:accessibilityNavbarIndex(focus);
+    if(action==A11Y_TAB || action==A11Y_BACKTAB) {
+        index=(index+(action==A11Y_BACKTAB?3:1))%4;
+        if(index==0)focusContentSelection();
+        else if(index==1) {
+            SetFocus(hwndTreeview);
+            if(!TreeView_GetSelection(hwndTreeview))TreeView_SelectItem(hwndTreeview,TreeView_GetRoot(hwndTreeview));
+            publishTreeSelection();
+        } else accessibilityNavbarFocus(index);
+        return GetFocus()!=focus?A11Y_CHANGED:A11Y_UNSUPPORTED;
+    }
+    if(action==A11Y_ADDRESS || action==A11Y_SEARCH) {
+        accessibilityNavbarFocus(action==A11Y_ADDRESS?2:3);return A11Y_HANDLED;
+    }
+    if(index<0) {focusContentSelection();focus=hwndContentView;index=0;}
+    if(action==A11Y_ENTER) {
+        if(index==0) {
+            if(ListView_GetNextItem(hwndContentView,-1,LVNI_SELECTED)<0)return A11Y_BOUNDARY;
+            updateSelectedItems();onMenuItemOpenClick();focusContentSelection();
+        } else if(index==1)activateTreeSelection();
+        else accessibilityNavbarEnter(index);
+        return A11Y_HANDLED;
+    }
+    if(action==A11Y_ESCAPE) {focusContentSelection();return A11Y_HANDLED;}
+    if(index==0) {
+        if(action==A11Y_UP || action==A11Y_DOWN || action==A11Y_HOME || action==A11Y_END ||
+           action==A11Y_PAGEUP || action==A11Y_PAGEDOWN)return moveList(action);
+        if(action==A11Y_BACKSPACE) {navigateUp();focusContentSelection();return A11Y_HANDLED;}
+        if(action==A11Y_SPACE) {
+            int row=ListView_GetNextItem(hwndContentView,-1,LVNI_FOCUSED);
+            if(row<0)return A11Y_BOUNDARY;
+            UINT old=ListView_GetItemState(hwndContentView,row,LVIS_SELECTED);
+            ListView_SetItemState(hwndContentView,row,old?0:LVIS_SELECTED,LVIS_SELECTED);
+            publishContentSelection();
+            return ListView_GetItemState(hwndContentView,row,LVIS_SELECTED)!=old?A11Y_CHANGED:A11Y_UNSUPPORTED;
+        }
+        if(action==A11Y_SELECTALL) {onMenuItemSelectAllClick();publishContentSelection();return A11Y_HANDLED;}
+        if(action==A11Y_COPY) {onMenuItemCopyClick();return A11Y_HANDLED;}
+        if(action==A11Y_CUT) {onMenuItemCutClick();return A11Y_HANDLED;}
+        if(action==A11Y_PASTE) {onMenuItemPasteClick();return A11Y_HANDLED;}
+        return A11Y_UNSUPPORTED;
+    }
+    if(index==1)return moveTree(action);
+    if(index>=2) {
+        if(action==A11Y_SELECTALL) {SendMessageW(focus,EM_SETSEL,0,-1);return A11Y_HANDLED;}
+        if(action==A11Y_COPY || action==A11Y_CUT || action==A11Y_PASTE) {
+            SendMessageW(focus,action==A11Y_COPY?WM_COPY:action==A11Y_CUT?WM_CUT:WM_PASTE,0,0);return A11Y_HANDLED;
+        }
+        if(action==A11Y_BACKSPACE) {
+            DWORD start=0,end=0;SendMessageW(focus,EM_GETSEL,(WPARAM)&start,(LPARAM)&end);
+            if(start==end && start>0)SendMessageW(focus,EM_SETSEL,start-1,end);
+            SendMessageW(focus,EM_REPLACESEL,TRUE,(LPARAM)L"");return A11Y_HANDLED;
+        }
+        if(action==A11Y_SPACE) {SendMessageW(focus,EM_REPLACESEL,TRUE,(LPARAM)L" ");return A11Y_HANDLED;}
+    }
+    return A11Y_UNSUPPORTED;
+}
