+/* Protocol 3 accepts integer actions only. The deadline is checked before any side effect.
+ * Each completion is identified by the caller's 24-bit token. No remote memory is used. */
+void accessibilityAsync(WPARAM packed, LPARAM deadline) {
+    UINT token=(UINT)(packed>>8),action=(UINT)(packed&255);
+    wchar_t status[96];
+    if(!token || action<A11Y_UP || action>A11Y_SEARCH)return;
+    if((LONG)(GetTickCount()-(DWORD)deadline)>0) {
+        StringCchPrintfW(status,96,L"%u|expired|0",token);
+        SetDlgItemTextW(hwndMain,0x7e04,status);return;
+    }
+    StringCchPrintfW(status,96,L"%u|running|0",token);SetDlgItemTextW(hwndMain,0x7e04,status);
+#ifdef WFM_A11Y_TEST
+    static BOOL delayed=FALSE;
+    if(action==A11Y_ENTER && !delayed) {delayed=TRUE;Sleep(5100);}
+#endif
+    LRESULT effect=accessibilityCommand(action);
+    StringCchPrintfW(status,96,L"%u|done|%u",token,(UINT)effect);SetDlgItemTextW(hwndMain,0x7e04,status);
+}
+
+/* Keep a bounded launch journal; no arguments, working directory, or full path is exported. */
+struct WatchedLaunch {HANDLE process;DWORD pid;wchar_t name[128];};
+static struct WatchedLaunch launches[8];
+static wchar_t launchJournal[8][256];
+static unsigned launchSequence;
+static void launchEvent(const wchar_t* state,DWORD pid,DWORD code,const wchar_t* name) {
+    wchar_t safe[128];StringCchCopyW(safe,128,name);
+    for(unsigned i=0;safe[i];i++)if(safe[i]==L'|' || safe[i]<32)safe[i]=L' ';
+    unsigned seq=++launchSequence;
+    StringCchPrintfW(launchJournal[seq%8],256,L"%u|%ls|%lu|%lu|%ls\n",seq,state,pid,code,safe);
+    wchar_t frame[2048]=L"";
+    for(unsigned n=seq>7?seq-7:1;n<=seq;n++)StringCchCatW(frame,2048,launchJournal[n%8]);
+    SetDlgItemTextW(hwndMain,0x7e05,frame);
+}
+void accessibilityPollLaunches(void) {
+    for(unsigned i=0;i<8;i++)if(launches[i].process) {
+        DWORD code=0;
+        if(GetExitCodeProcess(launches[i].process,&code) && code!=STILL_ACTIVE) {
+            launchEvent(L"exited",launches[i].pid,code,launches[i].name);
+            CloseHandle(launches[i].process);launches[i].process=NULL;
+        }
+    }
+}
+void accessibilityLaunch(const wchar_t* path,const wchar_t* directory) {
+    const wchar_t* name=wcsrchr(path,L'\\');name=name?name+1:path;
+    launchEvent(L"requested",0,0,name);
+    SHELLEXECUTEINFOW info={0};info.cbSize=sizeof(info);info.hwnd=hwndMain;
+    info.fMask=SEE_MASK_NOCLOSEPROCESS|SEE_MASK_FLAG_NO_UI;
+    info.lpVerb=L"open";info.lpFile=path;info.lpDirectory=directory;info.nShow=SW_SHOW;
+    SetLastError(0);
+    if(!ShellExecuteExW(&info)) {
+        DWORD error=GetLastError();launchEvent(L"failed",0,error,name);
+        wchar_t text[192];StringCchPrintfW(text,192,L"Không thể mở chương trình. Mã lỗi Windows: %lu.",error);
+        MessageBoxW(hwndMain,text,L"Winlator",MB_OK|MB_ICONERROR);return;
+    }
+    if(!info.hProcess) {launchEvent(L"shell-accepted-no-process",0,0,name);return;}
+    DWORD pid=GetProcessId(info.hProcess);launchEvent(L"started",pid,0,name);
+    accessibilityPollLaunches();
+    for(unsigned i=0;i<8;i++)if(!launches[i].process) {
+        launches[i].process=info.hProcess;launches[i].pid=pid;
+        StringCchCopyW(launches[i].name,128,name);return;
+    }
+    launchEvent(L"monitor-full",pid,0,name);CloseHandle(info.hProcess);
+}
