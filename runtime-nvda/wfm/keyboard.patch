+}
+int accessibilityNavbarIndex(HWND focus) {
+    return focus == hwndAddrEdit ? 2 : focus == hwndSearchEdit ? 3 : -1;
+}
+void accessibilityNavbarFocus(int index) {
+    if (index == 2) {setEditMode(true); SetFocus(hwndAddrEdit);}
+    else SetFocus(hwndSearchEdit);
+}
+void accessibilityNavbarEnter(int index) {
+    SendMessageW(hwndNavbar, WM_COMMAND, 0, (LPARAM)(index == 2 ? hwndGoButton : hwndSearchButton));
+    focusContentSelection();
+}
