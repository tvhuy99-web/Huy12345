+        text[1023] = 0;
+    } else StringCchPrintfW(text, 1024, L"Danh sách tệp. %d mục. Chưa chọn mục nào.", numItems);
+    SetDlgItemTextW(hwndMain, 0x7e01, text);
+}
+
+void focusContentSelection(void) {
+    SetFocus(hwndContentView);
+    if (numItems > 0 && ListView_GetNextItem(hwndContentView, -1, LVNI_FOCUSED) < 0) {
+        ListView_SetItemState(hwndContentView, 0, LVIS_FOCUSED | LVIS_SELECTED, LVIS_FOCUSED | LVIS_SELECTED);
+        ListView_EnsureVisible(hwndContentView, 0, FALSE);
+    }
+    publishContentSelection();
+}
