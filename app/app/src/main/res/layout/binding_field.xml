<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/LLTitleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical" >

        <TextView
            android:id="@+id/TVTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            style="@style/ListMenuButton"
            android:id="@+id/BTAdd"
            android:src="@drawable/icon_add"
            android:layout_margin="2dp"
            android:visibility="gone"
            android:contentDescription="@string/add"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >

        <com.winlator.widget.LabeledSpinner
            style="@style/ComboBox"
            android:id="@+id/SBindingType"
            android:layout_width="140dp"
            android:entries="@array/binding_type_entries"
            android:contentDescription="@string/a11y_binding_type" />

        <com.winlator.widget.LabeledSpinner
            style="@style/ComboBox"
            android:id="@+id/SBinding"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/a11y_binding" />
    </LinearLayout>
</LinearLayout>
