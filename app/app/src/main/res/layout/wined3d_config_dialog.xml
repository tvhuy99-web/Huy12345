<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="200dp" >

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/version" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" >

            <Spinner
                style="@style/ComboBox"
                android:id="@+id/SVersion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout style="@style/Toolbox" android:id="@+id/WineD3DToolbox">

                <ImageButton
                    style="@style/ListMenuButton"
                    android:src="@drawable/icon_install"
                    android:tag="install"
                    android:contentDescription="@string/install_component"
                    android:focusable="true" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:layout_marginRight="0dp"
                    android:src="@drawable/icon_remove"
                    android:tag="remove"
                    android:contentDescription="@string/remove"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ddraw_wrapper"
            android:id="@+id/a11y_label_wined3d_config_dialog_1"
            android:labelFor="@id/SDDrawWrapper" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SDDrawWrapper"
            android:entries="@array/ddraw_wrapper_entries" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/renderer"
            android:id="@+id/a11y_label_wined3d_config_dialog_2"
            android:labelFor="@id/SRenderer" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:id="@+id/SRenderer"
            android:entries="@array/wined3d_renderer_entries" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gpu_name"
            android:id="@+id/a11y_label_wined3d_config_dialog_3"
            android:labelFor="@id/SGPUName" />

        <Spinner
            style="@style/ComboBox"
            android:id="@+id/SGPUName"
            android:layout_width="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/offscreen_rendering_mode"
            android:id="@+id/a11y_label_wined3d_config_dialog_4"
            android:labelFor="@id/SOffscreenRenderingMode" />

        <Spinner
            style="@style/ComboBox"
            android:id="@+id/SOffscreenRenderingMode"
            android:layout_width="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/video_memory_size"
            android:id="@+id/a11y_label_wined3d_config_dialog_5"
            android:labelFor="@id/SVideoMemorySize" />

        <Spinner
            style="@style/ComboBox"
            android:id="@+id/SVideoMemorySize"
            android:layout_width="match_parent"
            android:entries="@array/video_memory_size_entries" />

        <CheckBox
            android:id="@+id/CBCSMT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_csmt"
            android:layout_marginTop="8dp" />

        <CheckBox
            android:id="@+id/CBStrictShaderMath"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_strict_shader_math" />
    </LinearLayout>
</ScrollView>
