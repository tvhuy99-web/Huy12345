# Generated Windows accessibility helper; CI builds it from source before Gradle.
/app/app/src/main/assets/accessibility/*.exe
/runtime-accessibility/*.log
/.preview-signing/
/app/app/src/main/assets/nvda/
/runtime-nvda/probe-results/
/runtime-nvda/touch-fixture.exe
/runtime-nvda/wfm/.source/
/runtime-nvda/wfm/.source.zip

# Local Python and IDE caches are never source files.
__pycache__/
*.pyc
*.pyo
.idea/
